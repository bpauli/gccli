Garmin answers 204 also for a log ID that does not exist, so the command first reads the day log and checks the ID. Then it asks, and sends the ID in the body of the DELETE.
-- args --
nutrition
delete
2026-10-15
bbbb2222
-- stdin --
y
-- route GET /nutrition-service/food/logs/2026-10-15 noeol --
{"mealDate":"2026-10-15","mealDetails":[{"meal":{"mealId":101,"mealName":"BREAKFAST"},"loggedFoods":[{"logId":"aaaa1111","logTimestamp":"2026-10-15T06:10:00.000Z","logCategory":"REGULAR_LOG","mealId":101,"mealTime":"07:00:00"}]},{"meal":{"mealId":105,"mealName":"SNACKS"},"loggedFoods":[{"logId":"bbbb2222","logTimestamp":"2026-10-15T09:30:00.000Z","logCategory":"QUICK_ADD","mealId":105,"mealTime":"09:30:00"}]}]}
-- route DELETE /nutrition-service/food/logs/2026-10-15 204 --
-- table stdout --
-- table stderr --
Delete food log entry bbbb2222 on 2026-10-15? [y/N]: Deleted food log entry bbbb2222 on 2026-10-15
-- table exit --
0
-- table requests --
GET /nutrition-service/food/logs/2026-10-15
DELETE /nutrition-service/food/logs/2026-10-15
  {
    "logIds": [
      "bbbb2222"
    ]
  }
