The benchmark is set, so set sends a PUT of its ID, and a repeat run converges. The key is not case sensitive.
-- args --
workouts
benchmarks
set
barbell_row
--weight
60
--reps
3
-- route GET /workout-service/benchmarks noeol --
[{"benchmarkCategoryKey":"CURL","benchmarkKey":"BARBELL_BICEPS_CURL"},{"id":2215652,"benchmarkKey":"BARBELL_ROW","benchmarkCategoryKey":"ROW","reps":5,"maxWeight":50.0,"oneRepMax":56.3,"weightUnit":{"unitId":8,"unitKey":"kilogram","factor":1000.0},"dateSet":"2026-10-21T08:05:00.0","linkedBenchmarkExercises":[{"categoryKey":"ROW","exerciseKey":"BARBELL_ROW"}]},{"benchmarkCategoryKey":"SQUAT","benchmarkKey":"BARBELL_BACK_SQUAT"}]
-- route PUT /workout-service/benchmarks/2215652 204 --
