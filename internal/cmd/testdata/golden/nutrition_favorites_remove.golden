Garmin answers 204 also for a food that is not a favorite, so the command first reads the favorites and checks the ID.
-- args --
nutrition
favorites
remove
1001
-- route GET /nutrition-service/favorite?start=0&limit=50&includeContent=true noeol --
{"consumables":[{"type":"FOOD","foodMetaData":{"foodId":"7","foodName":"Food 7","source":"FATSECRET"},"selectedNutritionContent":{"servingId":"s7","servingUnit":"g","calories":10},"servingQty":1.0},{"type":"FOOD","foodMetaData":{"foodId":"1001","foodName":"Food 1001","source":"FATSECRET"},"selectedNutritionContent":{"servingId":"s1001","servingUnit":"g","calories":10},"servingQty":1.0}],"hasMore":false}
-- route DELETE /nutrition-service/favorite/food/1001 204 --
