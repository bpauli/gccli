-- table stdout --
-- table stderr --
Usage: gccli segments create --from-activity=ID --start-km=KM --end-km=KM --name=NAME --activity-type=TYPE [flags]

Create a segment from a part of an activity track.

Flags:
  -h, --help                      Show context-sensitive help.
  -j, --json                      Output as JSON ($GCCLI_JSON).
      --plain                     Output as plain text (TSV) ($GCCLI_PLAIN).
      --header                    Print the column names as the first line of
                                  --plain output ($GCCLI_HEADER).
      --color="auto"              Color mode: auto, always, never
                                  ($GCCLI_COLOR).
      --account=STRING            Garmin account email ($GCCLI_ACCOUNT).
      --units="auto"              Unit system for distances, speeds, paces,
                                  elevations and weights in table and plain
                                  output: auto (Garmin profile), metric,
                                  statute_us, statute_uk ($GCCLI_UNITS).
      --version                   Print version information.

      --from-activity=ID          ID of the activity whose track the segment
                                  follows.
      --start-km=KM               Start of the segment, in kilometers from the
                                  start of the activity.
      --end-km=KM                 End of the segment, in kilometers from the
                                  start of the activity.
      --name=NAME                 Segment name.
      --activity-type=TYPE        Activity type: cycling or running.
      --classification="other"    Classification as segments classifications
                                  prints it: downhill, hill_climb, hills,
                                  other or sprint.
      --surface="paved"           Surface as segments surface-types prints it:
                                  dirt, gravel, mixed or paved.

