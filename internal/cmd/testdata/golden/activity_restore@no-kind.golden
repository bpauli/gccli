An answer without isMultiSportParent does not tell which restore request is right, so the command fails before any write.
-- args --
activity
restore
12345678
-- route GET /activity-service/activity/12345678 --
{"activityId":12345678,"activityName":"Morning Run"}
-- table stdout --
-- table stderr --
activity 12345678: the answer has no isMultiSportParent
-- table exit --
1
-- table requests --
GET /activity-service/activity/12345678
-- plain stdout --
-- plain stderr --
activity 12345678: the answer has no isMultiSportParent
-- plain exit --
1
-- plain requests --
GET /activity-service/activity/12345678
-- plain-header stdout --
-- plain-header stderr --
activity 12345678: the answer has no isMultiSportParent
-- plain-header exit --
1
-- plain-header requests --
GET /activity-service/activity/12345678
-- json stdout --
-- json stderr --
{"error":{"code":"error","message":"activity 12345678: the answer has no isMultiSportParent"}}
-- json exit --
1
-- json requests --
GET /activity-service/activity/12345678
