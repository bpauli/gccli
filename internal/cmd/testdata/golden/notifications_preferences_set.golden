The command reads the preferences, sets one key and sends the full object back.
-- args --
notifications
preferences
set
allowEmailWeeklySummary
false
-- route GET /notification-service/preference/userPreference --
{"allowEmailWeeklySummary":true,"allowPushBadges":false,"pushHour":7}
-- route PUT /notification-service/preference/userPreference noeol --
true
-- table stdout --
-- table stderr --
Set notification preference allowEmailWeeklySummary to false
-- table exit --
0
-- table requests --
GET /notification-service/preference/userPreference
PUT /notification-service/preference/userPreference
  {
    "allowEmailWeeklySummary": false,
    "allowPushBadges": false,
    "pushHour": 7
  }
