A distance goal in km. Garmin takes the distance in meters, the period in snake case and needs privacy, so the body has all four target fields with three of them null.
-- args --
goals
add
Run 50 km
--period
seven-days
--activity-type
running
--start
2026-10-12
--distance
50km
-- route POST /goal-service/goal/goal --
{"id":12345678,"name":"Run 50 km","type":"distance_accumulation","distanceInMeters":50000.0,"startDate":"2026-10-12","endDate":"2026-10-18","activityType":"running","period":"seven_days","privacy":"public","active":true,"completed":false}
