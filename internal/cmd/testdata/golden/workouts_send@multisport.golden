[{"deviceId":3001,"displayName":"Forerunner 265","workoutCapable":true,"runningWorkoutCapable":true,"cyclingWorkoutCapable":false,"swimWorkoutCapable":true,"swimWorkout2Capable":false,"workoutFileType":"FIT","multisportWorkoutCapable":true},{"deviceId":3002,"displayName":"Edge 1040","workoutCapable":true,"runningWorkoutCapable":false,"cyclingWorkoutCapable":true,"workoutFileType":"FIT"},{"deviceId":3003,"displayName":"fenix 8","workoutCapable":true,"runningWorkoutCapable":true,"cyclingWorkoutCapable":true,"swimWorkoutCapable":true,"swimWorkout2Capable":true,"multisportWorkoutCapable":true,"workoutFileType":"FIT"}]
