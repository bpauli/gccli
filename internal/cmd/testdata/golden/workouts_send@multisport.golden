A multisport workout needs multisportWorkoutCapable and the flag of the sport of each segment: only the fenix has all.
-- args --
workouts
send
111
-- route GET /workout-service/workout/111 --
{"workoutId":111,"workoutName":"Brick","sportType":{"sportTypeKey":"multi_sport"},"workoutSegments":[{"sportType":{"sportTypeKey":"cycling"}},{"sportType":{"sportTypeKey":"running"}}]}
