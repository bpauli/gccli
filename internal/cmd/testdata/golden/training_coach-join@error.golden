Garmin checks the number of training days per template and answers 400 with its own message, which the command passes on.
-- args --
training
coach-join
101
--name
Base Run
--end
2026-11-24
--day
MONDAY
--day
WEDNESDAY
--day
FRIDAY
-- route GET /userprofile-service/userprofile/adaptive-coaching-workouts --
[{"userProfilePk":1,"sport":"RUNNING","adaptiveCoachingWorkoutType":"PACE"}]
-- route POST /trainingplan-service/trainingplan/fbt-adaptive 400 noeol --
{"message":"5 available training days are required for this plan type","error":"BadRequestException"}
