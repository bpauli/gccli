Badge 1 is in progress and in both lists, so it prints once with the available entry. Badge 2 reached its target and has no limit. Badge 3 reached its target but can be earned again. Badge 4 has no progress.
-- args --
badges
in-progress
-- route GET /badge-service/badge/earned --
[{"badgeId":1,"badgeProgressValue":5,"badgeTargetValue":10,"badgeLimitCount":null,"badgeEarnedNumber":0},{"badgeId":2,"badgeProgressValue":10,"badgeTargetValue":10,"badgeLimitCount":null,"badgeEarnedNumber":1}]
-- route GET /badge-service/badge/available?showExclusiveBadge=true --
[{"badgeId":4,"badgeProgressValue":0,"badgeTargetValue":10},{"badgeId":3,"badgeProgressValue":1,"badgeTargetValue":1,"badgeLimitCount":5,"badgeEarnedNumber":2},{"badgeId":1,"badgeProgressValue":6,"badgeTargetValue":10,"badgeLimitCount":null,"badgeEarnedNumber":0}]
-- table stdout --
[
  {
    "badgeId": 1,
    "badgeProgressValue": 6,
    "badgeTargetValue": 10,
    "badgeLimitCount": null,
    "badgeEarnedNumber": 0
  },
  {
    "badgeId": 3,
    "badgeProgressValue": 1,
    "badgeTargetValue": 1,
    "badgeLimitCount": 5,
    "badgeEarnedNumber": 2
  }
]
-- table stderr --
