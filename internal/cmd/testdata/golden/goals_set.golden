-- table stderr --
Set intensity-minutes goal to 150 from 2026-10-12
-- table exit --
0
-- table requests --
PUT /goal-service/goal/user/effective/intensity-minutes/2026-10-12
  {
    "goalType": "INTENSITY_MINUTES",
    "goalValue": 150
  }
