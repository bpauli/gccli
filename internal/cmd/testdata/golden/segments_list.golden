The body asks for the segments of the user, and the distance is in the profile units.
-- args --
segments
list
--units
auto
-- route POST /segment-service/segment/filterSegments --
{"segments":[{"segmentPk":900001,"uuid":"a1b2c3d4-0000-4000-8000-000000000001","name":"Park Hill","ownerPk":7001,"activityId":5000001,"activityTypePk":1,"surfaceTypePk":2,"classificationPk":8,"distance":1.234,"grade":4.25,"favorite":true,"createDate":"2026-09-01 10:00:00.0"},{"segmentPk":900002,"uuid":"a1b2c3d4-0000-4000-8000-000000000002","name":"River Sprint","ownerPk":7001,"activityId":5000001,"activityTypePk":1,"surfaceTypePk":2,"classificationPk":8,"distance":0.4,"grade":4.25,"favorite":false,"createDate":"2026-09-01 10:00:00.0"}],"availableCount":2}
