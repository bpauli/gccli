The clock is 2026-10-15, so --until defaults to that day. Garmin counts the start from 1, so the default --offset 0 sends start=1.
-- args --
health
snapshots
list
-- route GET /wellnessactivity-service/activity/summary/list?limit=20&start=1&until=2026-10-15 --
[{"activityUuid":{"uuid":"1b4e28ba-2fa1-11d2-883f-0016d3cca427"},"activityName":"Health Snapshot","calendarDate":"2026-10-14","startTimestampLocal":"2026-10-14T08:00:00.0","duration":120.0,"summaryTypeDataList":[{"summaryType":"HEART_RATE","avgValue":62.0},{"summaryType":"STRESS","avgValue":21.0}]}]
