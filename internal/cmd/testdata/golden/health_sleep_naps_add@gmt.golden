Garmin names UTC "gmt" in the profile settings. The single digit hour is accepted.
-- args --
health
sleep
naps
add
9:00
09:20
-- route GET /userprofile-service/userprofile/settings --
{"displayName":"tester","timeZone":"gmt"}
-- route GET /userprofile-service/socialProfile/tester --
{"profileId":3141592}
-- route POST /sleep-service/sleep/nap --
{"calendarDate":"2026-10-15"}
