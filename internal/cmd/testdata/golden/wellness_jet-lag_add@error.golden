wellness
jet-lag
add
--from
Berlin
--to
Tokyo
--depart
2026-12-01T08:00+01:00
--arrive
2026-12-01T23:30+09:00
-- route POST /jetlag-service/jetlag/trip 400 --
{"message":"Flight timestamps must be within trip start and end dates","error":"BadRequestException"}
