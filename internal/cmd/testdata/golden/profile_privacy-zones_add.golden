The body carries the center and the radius. A negative longitude needs the --lon=VALUE form.
-- args --
profile
privacy-zones
add
--lat
52.52
--lon=-30.5
--radius
800
-- route POST /privacyzone-service/privacyZones --
{"centerLatitude":52.52,"centerLongitude":-30.5,"enhanced":false,"privacyZoneId":4321,"radius":800,"userProfileId":1001}
