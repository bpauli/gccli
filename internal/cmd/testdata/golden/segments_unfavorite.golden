The segment read gives the segmentPk, and the change names it, not the UUID.
-- args --
segments
unfavorite
a1b2c3d4-0000-4000-8000-000000000001
-- route GET /segment-service/segment/a1b2c3d4-0000-4000-8000-000000000001 --
{"segmentPk":900001,"uuid":"a1b2c3d4-0000-4000-8000-000000000001","name":"Park Hill","distance":1.234,"favorite":false}
-- route DELETE /segment-service/segment/user/900001 --
{"segmentPk":900001,"segmentName":"Park Hill","segmentUuid":"a1b2c3d4-0000-4000-8000-000000000001","segmentDistance":1.234,"favorite":false,"userProfilePk":7001}
