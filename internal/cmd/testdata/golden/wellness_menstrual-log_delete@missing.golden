Error case: Garmin answers 204 for a day without a log, and a DELETE of that day also answers 204. So no prompt is shown, no DELETE is sent and the exit code is 1.
-- args --
wellness
menstrual-log
delete
2026-10-01
--force
-- route GET /periodichealth-service/menstrualcycle/dailylog/2026-10-01 204 --
-- table stdout --
-- table stderr --
no menstrual log on 2026-10-01
-- table exit --
1
-- table requests --
GET /periodichealth-service/menstrualcycle/dailylog/2026-10-01
-- plain stdout --
-- plain stderr --
no menstrual log on 2026-10-01
-- plain exit --
1
-- plain requests --
GET /periodichealth-service/menstrualcycle/dailylog/2026-10-01
-- plain-header stdout --
-- plain-header stderr --
no menstrual log on 2026-10-01
-- plain-header exit --
1
-- plain-header requests --
GET /periodichealth-service/menstrualcycle/dailylog/2026-10-01
-- json stdout --
-- json stderr --
{"error":{"code":"error","message":"no menstrual log on 2026-10-01"}}
-- json exit --
1
-- json requests --
GET /periodichealth-service/menstrualcycle/dailylog/2026-10-01
