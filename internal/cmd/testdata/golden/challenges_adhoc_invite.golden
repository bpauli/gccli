The mutuals read maps each display name to its userId for inviteeIds. Garmin answers 204.
-- args --
challenges
adhoc
invite
0123456789ABCDEF0123456789ABCDEF
ann
bob
-- route GET /follower-service/follow/mutuals --
[{"displayName":"ann","followStatus":1,"fullName":"Ann Example","location":null,"profileImageUrls":[],"userId":2001,"userLevel":3,"userPoint":120},{"displayName":"bob","followStatus":1,"fullName":"Bob Example","location":null,"profileImageUrls":[],"userId":2002,"userLevel":2,"userPoint":40}]
-- route GET /userprofile-service/userprofile/settings --
{"displayName":"tester","profileId":3141592,"userData":{"measurementSystem":"metric"}}
-- route GET /userprofile-service/socialProfile/tester --
{"displayName":"tester","profileId":3141592,"userData":{"measurementSystem":"metric"}}
-- route POST /adhocchallenge-service/adHocChallenge/invite 204 --
