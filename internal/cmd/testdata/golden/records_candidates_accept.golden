The command sends the candidate back with its id set to null, as the Garmin Connect web app does. Garmin answers with the new record.
-- args --
records
candidates
accept
4200001
-- route GET /userprofile-service/userprofile/settings --
{"displayName":"tester","profileId":3141592,"userData":{"measurementSystem":"metric"}}
-- route GET /personalrecord-service/personalrecordcandidate/tester --
[{"id":4200001,"typeId":23,"status":"CANDIDATE","activityId":5100001,"activityName":"Pool Swim","activityType":"lap_swimming","value":1210.0,"prStartTimeGmt":1760000000000,"prStartTimeLocal":null,"poolLengthUnit":{"id":1,"key":"meter","factor":100.0}},{"id":4200002,"typeId":7,"status":"CANDIDATE","activityId":5100002,"activityName":"Long Run","activityType":"running","value":42195.0,"prStartTimeGmt":1760100000000,"prStartTimeLocal":null,"poolLengthUnit":null}]
-- route PUT /personalrecord-service/personalrecord/ --
{"id":4100009,"typeId":23,"status":"ACCEPTED","activityId":5100001,"activityName":"Pool Swim","activityType":"lap_swimming","value":1210.0,"prStartTimeGmt":1760000000000,"prStartTimeLocal":0,"poolLengthUnit":{"id":1,"key":"meter","factor":100.0}}
