A swim workout to a device with swimWorkout2Capable keeps the plain message URL.
-- args --
workouts
send
111
-- route GET /workout-service/workout/111 --
{"workoutId":111,"workoutName":"Pool 400","sportType":{"sportTypeId":4,"sportTypeKey":"swimming"}}
-- route GET /device-service/deviceregistration/devices --
[{"deviceId":3003,"displayName":"fenix 8","workoutCapable":true,"runningWorkoutCapable":true,"cyclingWorkoutCapable":true,"swimWorkoutCapable":true,"swimWorkout2Capable":true,"multisportWorkoutCapable":true,"workoutFileType":"FIT"},{"deviceId":3002,"displayName":"Edge 1040","workoutCapable":true,"runningWorkoutCapable":false,"cyclingWorkoutCapable":true,"workoutFileType":"FIT"}]
-- route POST /device-service/devicemessage/messages --
[{"deviceId":3003,"messageId":889}]
-- table stdout --
-- table stderr --
Sent workout "Pool 400" to fenix 8 (message 889). It reaches the device at its next sync. To cancel it before then, run: gccli devices messages cancel 889
