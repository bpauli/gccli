The device names its workout file type, and the message uses it in the URL and in fileType.
-- args --
workouts
send
111
-- route GET /workout-service/workout/111 --
{"workoutId":111,"workoutName":"Tempo Run","sportType":{"sportTypeId":1,"sportTypeKey":"running"}}
-- route GET /device-service/deviceregistration/devices --
[{"deviceId":3005,"displayName":"Forerunner 265","workoutCapable":true,"runningWorkoutCapable":true,"cyclingWorkoutCapable":false,"swimWorkoutCapable":true,"swimWorkout2Capable":false,"workoutFileType":"TCX"}]
-- route POST /device-service/devicemessage/messages --
[{"deviceId":3005,"messageId":890}]
