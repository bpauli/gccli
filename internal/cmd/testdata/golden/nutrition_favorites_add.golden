Garmin has no read of one food by ID, so the command finds the food in the search results for --query and saves its first serving as a favorite. Garmin answers 204.
-- args --
nutrition
favorites
add
1001
--query
apple
-- route GET /nutrition-service/food/search?searchExpression=apple&start=0&limit=50 noeol --
{"moreDataAvailable":false,"results":[{"type":"FOOD","foodMetaData":{"foodId":"1002","foodName":"Test Pie","foodType":"GENERIC","source":"FATSECRET","regionCode":"US","languageCode":"en"},"foodImages":[],"nutritionContents":[{"servingId":"2101","servingUnit":"slice","numberOfUnits":1.0,"calories":300}],"isRecent":false,"isFavorite":false},{"type":"FOOD","foodMetaData":{"foodId":"1001","foodName":"Test Apple","foodType":"GENERIC","source":"FATSECRET","regionCode":"US","languageCode":"en"},"foodImages":[],"nutritionContents":[{"servingId":"2001","servingUnit":"medium","numberOfUnits":1.0,"calories":95},{"servingId":"2002","servingUnit":"cup, sliced","numberOfUnits":1.0,"calories":56.5}],"isRecent":false,"isFavorite":false}]}
-- route PUT /nutrition-service/favorite/food 204 --
-- table stdout --
-- table stderr --
Added Test Apple (1 x medium) to favorite foods
-- table exit --
0
-- table requests --
GET /nutrition-service/food/search?searchExpression=apple&start=0&limit=50
PUT /nutrition-service/favorite/food
  {
    "foodId": "1001",
    "servingId": "2001",
    "source": "FATSECRET",
    "servingQty": 1,
    "regionCode": "US",
    "languageCode": "en"
  }
