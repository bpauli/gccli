--serving picks a serving by its unit, without regard to case. --servings sets the quantity, and --time the meal time.
-- args --
nutrition
add
2026-10-15
1001
--query
apple
-m
lunch
--serving
Cup, Sliced
--servings
2.5
--time
12:30
-- route GET /nutrition-service/food/search?searchExpression=apple&start=0&limit=50 noeol --
