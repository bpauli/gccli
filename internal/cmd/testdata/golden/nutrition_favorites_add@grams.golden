A serving can hold more than one unit. The message names the size of the serving (2 x 100 g), not the unit alone, which would read as 2 grams.
-- args --
nutrition
favorites
add
1001
--query
apple
--serving
g
--servings
2
-- route GET /nutrition-service/food/search?searchExpression=apple&start=0&limit=50 noeol --
{"moreDataAvailable":false,"results":[{"type":"FOOD","foodMetaData":{"foodId":"1001","foodName":"Test Apple","foodType":"GENERIC","source":"FATSECRET","regionCode":"US","languageCode":"en"},"foodImages":[],"nutritionContents":[{"servingId":"2001","servingUnit":"medium","numberOfUnits":1.0,"calories":95},{"servingId":"2003","servingUnit":"g","numberOfUnits":100.0,"calories":52}],"isRecent":false,"isFavorite":false}]}
-- route PUT /nutrition-service/favorite/food 204 --
-- table stdout --
-- table stderr --
Added Test Apple (2 x 100 g) to favorite foods
-- table exit --
0
-- table requests --
GET /nutrition-service/food/search?searchExpression=apple&start=0&limit=50
PUT /nutrition-service/favorite/food
  {
    "foodId": "1001",
    "servingId": "2003",
    "source": "FATSECRET",
    "servingQty": 2,
    "regionCode": "US",
    "languageCode": "en"
  }
