{"displayName":"tester","timeZone":"Europe/Berlin"}
-- table stdout --
-- table stderr --
the time 02:30 is ambiguous on 2026-10-25 in your Garmin time zone (Europe/Berlin) because the clocks go back
-- table exit --
1
