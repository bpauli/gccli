The command reads the feed ID, asks, and deletes the feed.
-- args --
calendar
export
disable
-- stdin --
y
-- route GET /calendar-service/export --
{"baseUrl":"http://localhost/proxy/calendar-service/export","id":"0123456789abcdef0123456789abcdef"}
-- route DELETE /calendar-service/export/0123456789abcdef0123456789abcdef 204 --
