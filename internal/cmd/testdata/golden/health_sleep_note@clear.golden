Garmin removes the note when the text is empty, so --clear sends an empty userNote.
-- args --
health
sleep
note
2026-10-15
--clear
-- route PUT /sleep-service/sleep/dailySleep/2026-10-15/note --
{"userNote":""}
-- table stdout --
-- table stderr --
Removed the sleep note of 2026-10-15
-- table exit --
0
-- table requests --
PUT /sleep-service/sleep/dailySleep/2026-10-15/note
  {
    "userNote": ""
  }
