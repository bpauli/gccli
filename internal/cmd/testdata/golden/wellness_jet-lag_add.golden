A flight and its return flight. The trip runs from the day of the first departure to the day of the last arrival, and each time keeps its own UTC offset.
-- args --
wellness
jet-lag
add
--from
Frankfurt, Germany
--to
New York, USA
--depart
2026-11-02T10:00+01:00
--arrive
2026-11-02T13:00-05:00
--return-depart
2026-11-09T18:00-05:00
--return-arrive
2026-11-10T08:00+01:00
-- route POST /jetlag-service/jetlag/trip --
{"userId": 1000, "timeDifference": 0, "startDate": "2026-11-02", "endDate": "2026-11-10", "flights": [{"flightId": 810, "tripId": 4720, "originLocation": "Frankfurt, Germany", "originTimezone": "+01:00", "originTimestamp": "2026-11-02T10:00:00.0", "destinationLocation": "New York, USA", "destinationTimezone": "-05:00", "destinationTimestamp": "2026-11-02T13:00:00.0"}, {"flightId": 811, "tripId": 4720, "originLocation": "New York, USA", "originTimezone": "-05:00", "originTimestamp": "2026-11-09T18:00:00.0", "destinationLocation": "Frankfurt, Germany", "destinationTimezone": "+01:00", "destinationTimestamp": "2026-11-10T08:00:00.0"}], "tripId": 4720}
