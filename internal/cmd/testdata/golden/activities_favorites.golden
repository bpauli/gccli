Garmin wraps the list in activityList. The command sends only limit, because Garmin reads it as the last item.
-- args --
activities
favorites
-- route GET /userprofile-service/userprofile/settings --
{"displayName":"tester","profileId":3141592,"userData":{"measurementSystem":"metric"}}
-- route GET /activitylist-service/activities/favorite/tester?limit=20 --
{"activityList":[{"activityId":12345678,"activityName":"Morning Run","startTimeLocal":"2026-01-10 09:00:00","activityType":{"typeKey":"running"},"distance":10012.5,"duration":3005.2,"calories":712},{"activityId":12345679,"activityName":"Hill Ride","startTimeLocal":"2026-01-04 14:00:00","activityType":{"typeKey":"cycling"},"distance":42000,"duration":5400,"calories":1100}],"filter":{},"pagination":{"start":1,"limit":20},"requestorRelationship":"SELF"}
