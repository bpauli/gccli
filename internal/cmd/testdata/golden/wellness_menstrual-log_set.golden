POST /periodichealth-service/menstrualcycle/dailylog/2026-10-01
  {
    "calendarDate": "2026-10-01",
    "flow": "HEAVY",
    "hasBabyMovement": false,
    "notes": "x",
    "ovulationDay": true,
    "reportTimestamp": "2026-10-15T09:30:00.000",
    "symptoms": [
      "CRAMPS",
      "HEADACHE"
    ]
  }
