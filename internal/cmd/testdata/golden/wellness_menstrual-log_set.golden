Garmin replaces the whole day, so set reads the saved log and sends it back with the new flow. The symptoms, the note and the ovulation day stay. hasBabyMovement is not modeled and stays too. userProfilePk and the saved reportTimestamp are not sent: reportTimestamp is the clock time in UTC (2026-10-15 09:30).
-- args --
wellness
menstrual-log
set
2026-10-01
--flow
heavy
-- route GET /periodichealth-service/menstrualcycle/dailylog/2026-10-01 --
{"userProfilePk":1,"calendarDate":"2026-10-01","symptoms":["CRAMPS","HEADACHE"],"moods":null,"discharge":null,"flow":"LIGHT","sexDrive":null,"sexualActivity":null,"notes":"x","reportTimestamp":"2026-10-20T08:00:00.0","hasBabyMovement":false,"ovulationDay":true}
-- route POST /periodichealth-service/menstrualcycle/dailylog/2026-10-01 --
{"userProfilePk":1,"calendarDate":"2026-10-01","symptoms":["CRAMPS","HEADACHE"],"moods":null,"discharge":null,"flow":"HEAVY","sexDrive":null,"sexualActivity":null,"notes":"x","reportTimestamp":"2026-10-15T09:30:00.0","ovulationDay":true}
-- table stdout --
-- table stderr --
Saved menstrual log for 2026-10-01
-- table exit --
0
