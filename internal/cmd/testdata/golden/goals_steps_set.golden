Reads the steps goal of 2026-10-12, sets a fixed goal of 9000 steps and sends the full object back.
-- args --
goals
steps
set
9000
--date
2026-10-12
-- route GET /wellness-service/wellness/wellness-goals/consolidated/steps/2026-10-12 --
{"userGoal":0,"deviceGoal":7500,"effective":"2026-10-12","goalType":"STEPS","syncedToDevice":true,"userGoalCategory":"my-auto"}
-- route PUT /wellness-service/wellness/wellness-goals/consolidated/steps/2026-10-12 --
{"userGoal":9000,"deviceGoal":7500,"effective":"2026-10-12","goalType":"STEPS","syncedToDevice":true,"userGoalCategory":"manual"}
