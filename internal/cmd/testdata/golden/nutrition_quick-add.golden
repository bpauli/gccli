Snacks has no time window, so the meal time is the current time. The macros and the name go in the item, and the message names the new entry, found in the answer by the time of the write.
-- args --
nutrition
quick-add
2026-10-15
--meal
snacks
--calories
120
--carbs
10.5
--protein
5
--fat
2
--name
Coffee with milk
-- route GET /nutrition-service/meals/2026-10-15 noeol --
{"dailyViewType":"TIMELINE_VIEW","meals":[{"mealId":101,"mealName":"BREAKFAST","startTime":"07:00:00","endTime":"08:59:00","enabled":true},{"mealId":102,"mealName":"LUNCH","startTime":"12:00:00","endTime":"13:59:00","enabled":true},{"mealId":103,"mealName":"DINNER","startTime":"18:00:00","endTime":"20:59:00","enabled":true},{"mealId":104,"mealName":"CUSTOM_MEAL_1","startTime":null,"endTime":null,"enabled":false},{"mealId":105,"mealName":"SNACKS","startTime":null,"endTime":null,"enabled":true}]}
-- route PUT /nutrition-service/food/logs/quickAdd noeol --
{"mealDate":"2026-10-15","mealDetails":[{"meal":{"mealId":101,"mealName":"BREAKFAST"},"loggedFoods":[{"logId":"aaaa1111","logTimestamp":"2026-10-15T06:10:00.000Z","logCategory":"REGULAR_LOG","mealId":101,"mealTime":"07:00:00"}]},{"meal":{"mealId":105,"mealName":"SNACKS"},"loggedFoods":[{"logId":"bbbb2222","logTimestamp":"2026-10-15T09:30:00.000Z","logCategory":"QUICK_ADD","mealId":105,"mealTime":"09:30:00"}]}]}
-- table stdout --
-- table stderr --
Added 120 kcal to snacks on 2026-10-15 (log ID: bbbb2222)
-- table exit --
0
-- table requests --
GET /nutrition-service/meals/2026-10-15
PUT /nutrition-service/food/logs/quickAdd
  {
    "mealDate": "2026-10-15",
    "quickAddItems": [
      {
        "name": "Coffee with milk",
        "logId": null,
        "logTimestamp": "2026-10-15T09:30:00.000Z",
        "logSource": "GCW",
        "logCategory": "QUICK_ADD",
        "mealTime": "09:30:00",
        "mealId": 105,
        "action": "ADD",
        "calories": 120,
        "carbs": 10.5,
        "protein": 5,
        "fat": 2
      }
    ]
  }
