The search is a POST with a form body. Garmin counts start from 1, so the first group is start=1.
-- args --
groups
search
running
-- route POST /group-service/keyword --
{"effectiveKeyword":"running","groupDTOs":[{"id":1001,"groupName":"Example Run Club","groupPrivacy":"PUBLIC","groupMemberCount":null,"location":"Example City","membershipStatus":"","primaryActivities":["running"]},{"id":1002,"groupName":"Trail Friends","groupPrivacy":"PRIVATE","groupMemberCount":null,"location":null,"membershipStatus":"","primaryActivities":["trail_running"]}],"limit":20,"originalKeyword":"running","start":1}
