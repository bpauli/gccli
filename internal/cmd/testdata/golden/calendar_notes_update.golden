The PUT carries the full GET object with the new name, because Garmin rejects a body without the date. The text stays.
-- args --
calendar
notes
update
118934
--name
Tempo run
-- route GET /calendar-service/note/118934 --
{"content":"Easy pace","date":"2026-10-20","id":118934,"noteName":"Long run"}
-- route PUT /calendar-service/note/118934 204 --
-- table stdout --
-- table stderr --
Updated note 118934
-- table exit --
0
-- table requests --
GET /calendar-service/note/118934
PUT /calendar-service/note/118934
  {
    "content": "Easy pace",
    "date": "2026-10-20",
    "id": 118934,
    "noteName": "Tempo run"
  }
