            "wellness menstrual-log set --flow") COMPREPLY=($(compgen -W 'light medium heavy' -- "$cur")) ;;
            "wellness menstrual-log set --symptoms") COMPREPLY=($(compgen -W 'acne backache bloating body-aches constipation cramps cravings diarrhea dizziness fatigue headache insomnia nausea tender-breasts' -- "$cur")) ;;
