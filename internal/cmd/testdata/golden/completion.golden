ss jet-lag update"|"wellness jet-lag delete"|"wellness jet-lag status"|"exercises"|"exercises list"|"notifications"|"notifications list"|"notifications unread"|"notifications dismiss"|"notifications undismiss"|"notifications preferences"|"notifications preferences view"|"notifications preferences set"|"social"|"social connections"|"social followers"|"social following"|"social requests"|"social feed"|"social follow"|"social unfollow"|"social follow-requests"|"social accept"|"social decline"|"social remove-follower"|"social mute"|"social unmute"|"social muted"|"social search"|"groups"|"groups list"|"groups search"|"groups show"|"groups members"|"groups feed"|"groups activities"|"groups challenges"|"groups join"|"groups leave"|"groups create"|"groups edit"|"groups delete"|"insights"|"insights options"|"insights compare"|"insights preferences"|"golf"|"golf scorecards"|"golf courses"|"golf course"|"golf stats"|"golf shot-stats"|"golf clubs"|"golf club-types"|"golf club-flex-types"|"golf leaderboards"|"reload"|"completion") cmd_path=${cmd_path:+$cmd_path }$w ;;
                    *)
                        case $cmd_path in
