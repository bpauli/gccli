        "wellness menstrual-summary") COMPREPLY=($(compgen -W '--start --end' -- "$cur")) ;;
        "wellness menstrual-calendar") COMPREPLY=($(compgen -W '--start --end' -- "$cur")) ;;
        "wellness jet-lag") COMPREPLY=($(compgen -W 'list status' -- "$cur")) ;;
        "exercises") COMPREPLY=($(compgen -W 'list' -- "$cur")) ;;
        "exercises list") COMPREPLY=($(compgen -W '--category -c' -- "$cur")) ;;
        "notifications") COMPREPLY=($(compgen -W 'list preferences' -- "$cur")) ;;
        "social") COMPREPLY=($(compgen -W 'connections followers following requests feed' -- "$cur")) ;;
        "social connections") COMPREPLY=($(compgen -W '--limit -l --offset' -- "$cur")) ;;
        "groups") COMPREPLY=($(compgen -W 'list' -- "$cur")) ;;
    esac
}

