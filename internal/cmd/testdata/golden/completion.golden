complete -F _gccli_completions gccli
-- plain-header stderr --
-- plain-header exit --
0
-- plain-header requests --
-- json stdout --
#!/bin/bash
# bash completion for gccli
# Generated by gccli completion bash

_gccli_completions() {
    # _init_completion is a guard only: bash-completion returns non-zero after
    # it completed a redirection or a $VAR itself. Its words are not used.
    local cur prev words cword
    if type _init_completion &>/dev/null; then
        _init_completion || return
    fi
    # Words come from the line up to the cursor, split at whitespace only, so
    # they are the same with and without bash-completion and on bash 3.2.
    # bash before 4.3 counts COMP_POINT in bytes, and ${s:0:n} counts
    # characters unless the locale is C.
    local line unquoted i w n
    if (( BASH_VERSINFO[0] < 4 || BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 3 )); then
        local LC_ALL=C
    fi
    line=${COMP_LINE:0:COMP_POINT}
    unquoted=${line//[\"\']/}
    IFS=$' \t\n' read -ra words <<< "$unquoted"
    [[ -z $line || $line == *[[:space:]] ]] && words+=("")
    n=$(( ${#words[@]} - 1 ))
    (( n > 0 )) || return

    # bash replaces only its own current word: the text after an open quote,
    # or else the text after the last break character that is not quoted
    # and not escaped. Replies must match that word. bash 3.2 does not split
    # COMP_WORDS at break characters, so take it from the line.
    # The scan jumps from one quote or backslash to the next, because an
    # index lookup per character is slow on a long line. masked is the line
    # with each quoted or escaped character replaced by 0, so the break
    # character cut on it cannot stop inside a quote or after a backslash.
    local c quote="" rest=$line seg masked="" tail re='^([^"'\''\\]*)(["'\''\\]?)'
    while [[ $rest =~ $re ]]; do
        seg=${BASH_REMATCH[1]} c=${BASH_REMATCH[2]}
        rest=${rest:${#BASH_REMATCH[0]}}
        [[ -n $quote ]] && printf -v seg '%.*d' "${#seg}" 0
        masked+=$seg
        if [[ -z $c && -n $rest ]]; then
            # The regex stops at a byte that is not a character in the locale.
            c=${rest:0:1} rest=${rest:1}
        fi
        [[ -n $c ]] || break
        case $quote$c in
            \\|\"\\) seg=${rest:0:1}; rest=${rest:1}; masked+=${seg:+0} ;;
            \"|\') quote=$c cur=$rest ;;
            \"\"|\'\') quote="" ;;
        esac
        masked+=0
    done
    if [[ -z $quote ]]; then
        tail=$masked
        for ((i = 0; i < ${#COMP_WORDBREAKS}; i++)); do
            c=${COMP_WORDBREAKS:i:1}
            tail=${tail##*"$c"}
        done
        cur=${line:${#line}-${#tail}}
    fi

    # A positional at a command with a default subcommand that takes
    # arguments belongs to that subcommand.
    local cmd_path=""
    for ((i = 1; i < n; i++)); do
        w=${words[i]}
        case $w in
            -*=*) ;;
            --account|--active-met|--basal-met|--bmi|--body-fat|--bone-mass|--category|--color|--date|--diastolic|--distance|--duration|--end|--exercise|--format|--goal|--limit|--locale|--location|--max-chart|--max-poly|--metabolic-age|--mfa-code|--months|--muscle-mass|--name|--note|--notes|--offset|--output|--parent-type-id|--percent-hydration|--physique-rating|--privacy|--pulse|--sort|--start|--status|--step|--systolic|--time|--timezone|--type|--type-id|--type-key|--unit|--units|--url|--visceral-fat-mass|--visceral-fat-rating|--weeks|-c|-d|-e|-l|-n|-o|-p|-s|-t) ((i++)) ;;
            -*) ;;
            *)
                case "${cmd_path:+$cmd_path }$w" in
                    "auth"|"auth login"|"auth status"|"auth remove"|"auth token"|"auth export"|"auth import"|"activities"|"activities list"|"activities count"|"activities search"|"activities types"|"activities pending"|"activities stats"|"activities stats view"|"activities stats monthly"|"activity"|"activity summary"|"activity details"|"activity splits"|"activity typed-splits"|"activity split-summaries"|"activity weather"|"activity hr-zones"|"activity power-zones"|"activity exercise-sets"|"activity exercise-sets show"|"activity exercise-sets set"|"activity gear"|"activity comments"|"activity likes"|"activity download"|"activity upload"|"activity create"|"activity rename"|"activity retype"|"activity delete"|"workouts"|"workouts list"|"workouts detail"|"workouts download"|"workouts upload"|"workouts update"|"workouts create"|"workouts types"|"workouts schedule"|"workouts schedule add"|"workouts schedule list"|"workouts schedule remove"|"workouts schedule export"|"workouts benchmarks"|"workouts benchmarks list"|"workouts delete"|"health"|"health summary"|"health steps"|"health steps view"|"health steps daily"|"health steps weekly"|"health steps monthly"|"health calories"|"health calories weekly"|"health pushes"|"health pushes weekly"|"health pushes monthly"|"health lifetime-totals"|"health hr"|"health hr view"|"health hr daily"|"health hr weekly"|"health rhr"|"health floors"|"health floors view"|"health floors daily"|"health floors weekly"|"health sleep"|"health sleep view"|"health sleep naps"|"health sleep daily"|"health sleep weekly"|"health sleep overall"|"health stress"|"health stress view"|"health stress daily"|"health stress weekly"|"health respiration"|"health respiration view"|"health respiration daily"|"health spo2"|"health hrv"|"health body-battery"|"health body-battery view"|"health body-battery range"|"health intensity-minutes"|"health intensity-minutes view"|"health intensity-minutes weekly"|"health training-readiness"|"health training-status"|"health training-status view"|"health training-status daily"|"health fitness-age"|"health max-metrics"|"health lactate-threshold"|"health cycling-ftp"|"health critical-swim-speed"|"health critical-swim-speed view"|"health critical-swim-speed range"|"health power-to-weight"|"health thresholds"|"health thresholds cycling-ftp"|"health thresholds lactate-heart-rate"|"health thresholds lactate-speed"|"health thresholds power-to-weight"|"health race-predictions"|"health race-predictions view"|"health race-predictions range"|"health endurance-score"|"health hill-score"|"health power-curve"|"health running-economy"|"health acclimation"|"health one-rep-max"|"health events"|"health lifestyle"|"body"|"body composition"|"body weigh-ins"|"body daily-weigh-ins"|"body latest"|"body add-weight"|"body add-composition"|"body delete-weight"|"body blood-pressure"|"body add-blood-pressure"|"body delete-blood-pressure"|"body glucose"|"devices"|"devices list"|"devices settings"|"devices primary"|"devices solar"|"devices alarms"|"devices last-used"|"devices sensors"|"devices backups"|"devices historical"|"devices messages"|"gear"|"gear list"|"gear stats"|"gear activities"|"gear defaults"|"gear link"|"gear unlink"|"gear types"|"gear collections"|"gear collections list"|"goals"|"goals list"|"goals weight"|"badges"|"badges earned"|"badges available"|"badges in-progress"|"badges detail"|"badges compare"|"badges leaderboard"|"courses"|"courses list"|"courses favorites"|"courses detail"|"courses download"|"courses import"|"courses send"|"courses delete"|"challenges"|"challenges list"|"challenges badge"|"challenges available"|"challenges completed"|"challenges virtual"|"challenges virtual available"|"challenges virtual completed"|"challenges virtual in-progress"|"records"|"records list"|"records types"|"records activity"|"profile"|"profile view"|"profile settings"|"profile privacy"|"profile privacy view"|"profile privacy-zones"|"profile privacy-zones list"|"profile hr-zones"|"profile power-zones"|"hydration"|"hydration view"|"hydration daily"|"hydration weekly"|"hydration add"|"nutrition"|"nutrition food-log"|"nutrition meals"|"nutrition settings"|"training"|"training plans"|"training plan"|"training active"|"training coach-workouts"|"events"|"events list"|"events upcoming"|"events add"|"events delete"|"wellness"|"wellness menstrual-cycle"|"wellness menstrual-summary"|"wellness menstrual-calendar"|"wellness pregnancy-summary"|"wellness jet-lag"|"wellness jet-lag list"|"wellness jet-lag status"|"exercises"|"exercises list"|"notifications"|"notifications list"|"notifications preferences"|"social"|"social connections"|"social followers"|"social following"|"social requests"|"social feed"|"groups"|"groups list"|"reload"|"completion") cmd_path=${cmd_path:+$cmd_path }$w ;;
                    *)
                        case $cmd_path in
                            "activities") cmd_path="activities list" ;;
                            "activities stats") cmd_path="activities stats view" ;;
                            "activity") cmd_path="activity summary" ;;
                            "activity exercise-sets") cmd_path="activity exercise-sets show" ;;
                            "workouts") cmd_path="workouts list" ;;
                            "workouts benchmarks") cmd_path="workouts benchmarks list" ;;
                            "health") cmd_path="health summary" ;;
                            "health steps") cmd_path="health steps view" ;;
                            "health hr") cmd_path="health hr view" ;;
                            "health floors") cmd_path="health floors view" ;;
                            "health sleep") cmd_path="health sleep view" ;;
                            "health stress") cmd_path="health stress view" ;;
                            "health respiration") cmd_path="health respiration view" ;;
                            "health body-battery") cmd_path="health body-battery view" ;;
                            "health intensity-minutes") cmd_path="health intensity-minutes view" ;;
                            "health training-status") cmd_path="health training-status view" ;;
                            "health critical-swim-speed") cmd_path="health critical-swim-speed view" ;;
                            "health race-predictions") cmd_path="health race-predictions view" ;;
                            "body") cmd_path="body composition" ;;
                            "devices") cmd_path="devices list" ;;
                            "gear") cmd_path="gear list" ;;
                            "gear collections") cmd_path="gear collections list" ;;
                            "goals") cmd_path="goals list" ;;
                            "badges") cmd_path="badges earned" ;;
                            "courses") cmd_path="courses list" ;;
                            "challenges") cmd_path="challenges list" ;;
                            "records") cmd_path="records list" ;;
                            "profile") cmd_path="profile view" ;;
                            "profile privacy") cmd_path="profile privacy view" ;;
                            "profile privacy-zones") cmd_path="profile privacy-zones list" ;;
                            "hydration") cmd_path="hydration view" ;;
                            "nutrition") cmd_path="nutrition food-log" ;;
                            "training") cmd_path="training plans" ;;
                            "events") cmd_path="events list" ;;
                            "wellness jet-lag") cmd_path="wellness jet-lag list" ;;
                            "exercises") cmd_path="exercises list" ;;
                            "notifications") cmd_path="notifications list" ;;
                            "groups") cmd_path="groups list" ;;
                        esac
                        ;;
                esac ;;
        esac
    done

    local word=${words[n]} before_cur flag=""
    before_cur=${word%"$cur"}
    case $before_cur in
        "")
            case ${words[n-1]} in
                --account|--active-met|--basal-met|--bmi|--body-fat|--bone-mass|--category|--color|--date|--diastolic|--distance|--duration|--end|--exercise|--format|--goal|--limit|--locale|--location|--max-chart|--max-poly|--metabolic-age|--mfa-code|--months|--muscle-mass|--name|--note|--notes|--offset|--output|--parent-type-id|--percent-hydration|--physique-rating|--privacy|--pulse|--sort|--start|--status|--step|--systolic|--time|--timezone|--type|--type-id|--type-key|--unit|--units|--url|--visceral-fat-mass|--visceral-fat-rating|--weeks|-c|-d|-e|-l|-n|-o|-p|-s|-t) flag=${words[n-1]} ;;
            esac ;;
        -*=) flag=${before_cur%=} ;;
        *) return ;;
    esac

    if [[ -n $flag ]]; then
        case "$cmd_path $flag" in
            "activity download --format") COMPREPLY=($(compgen -W 'fit gpx tcx kml csv' -- "$cur")) ;;
            "workouts create --type") COMPREPLY=($(compgen -W 'run bike swim strength cardio hiit yoga pilates mobility multisport custom' -- "$cur")) ;;
            "workouts create --unit") COMPREPLY=($(compgen -W 'km mi' -- "$cur")) ;;
            "body add-weight --unit") COMPREPLY=($(compgen -W 'kg lbs' -- "$cur")) ;;
            "goals list --status") COMPREPLY=($(compgen -W 'active future past' -- "$cur")) ;;
            "courses download --format") COMPREPLY=($(compgen -W 'fit gpx' -- "$cur")) ;;
            "courses import --privacy"|"courses import -p") COMPREPLY=($(compgen -W '1 2 4' -- "$cur")) ;;
            "events list --sort") COMPREPLY=($(compgen -W 'eventDate_asc eventDate_desc' -- "$cur")) ;;
            "events add --type"|"events add -t") COMPREPLY=($(compgen -W 'running trail_running cycling gravel_cycling mountain_biking swimming triathlon multi_sport hiking walking fitness_equipment motorcycling winter_sport other' -- "$cur")) ;;
            *" --color") COMPREPLY=($(compgen -W 'auto always never' -- "$cur")) ;;
            *" --units") COMPREPLY=($(compgen -W 'auto metric statute_us statute_uk' -- "$cur")) ;;
        esac
        return
    fi

    case $cmd_path in
        "") COMPREPLY=($(compgen -W 'auth activities activity workouts health body devices gear goals badges courses challenges records profile hydration nutrition training events wellness exercises notifications social groups reload completion --json -j --plain --header --color --account --units --version' -- "$cur")) ;;
        "auth") COMPREPLY=($(compgen -W 'login status remove token export import' -- "$cur")) ;;
        "auth login") COMPREPLY=($(compgen -W '--headless --mfa-code' -- "$cur")) ;;
        "activities") COMPREPLY=($(compgen -W 'list count search types pending stats' -- "$cur")) ;;
        "activities list") COMPREPLY=($(compgen -W '--limit -l --offset --type -t' -- "$cur")) ;;
        "activities search") COMPREPLY=($(compgen -W '--limit -l --offset --start --end' -- "$cur")) ;;
        "activities stats") COMPREPLY=($(compgen -W 'view monthly' -- "$cur")) ;;
        "activity") COMPREPLY=($(compgen -W 'summary details splits typed-splits split-summaries weather hr-zones power-zones exercise-sets gear comments likes download upload create rename retype delete' -- "$cur")) ;;
        "activity details") COMPREPLY=($(compgen -W '--max-chart --max-poly' -- "$cur")) ;;
        "activity exercise-sets") COMPREPLY=($(compgen -W 'show set' -- "$cur")) ;;
        "activity exercise-sets set") COMPREPLY=($(compgen -W '--exercise -e' -- "$cur")) ;;
        "activity download") COMPREPLY=($(compgen -W '--format --output -o' -- "$cur")) ;;
        "activity create") COMPREPLY=($(compgen -W '--name --type --distance --duration --date' -- "$cur")) ;;
        "activity retype") COMPREPLY=($(compgen -W '--type-id --type-key --parent-type-id' -- "$cur")) ;;
        "activity delete") COMPREPLY=($(compgen -W '--force -f' -- "$cur")) ;;
        "workouts") COMPREPLY=($(compgen -W 'list detail download upload update create types schedule benchmarks delete' -- "$cur")) ;;
        "workouts list") COMPREPLY=($(compgen -W '--limit -l --offset' -- "$cur")) ;;
        "workouts download") COMPREPLY=($(compgen -W '--output -o' -- "$cur")) ;;
        "workouts create") COMPREPLY=($(compgen -W '--type --step -s --unit' -- "$cur")) ;;
        "workouts schedule") COMPREPLY=($(compgen -W 'add list remove export' -- "$cur")) ;;
        "workouts schedule list") COMPREPLY=($(compgen -W '--start --end' -- "$cur")) ;;
        "workouts schedule remove") COMPREPLY=($(compgen -W '--force -f' -- "$cur")) ;;
        "workouts schedule export") COMPREPLY=($(compgen -W '--start' -- "$cur")) ;;
        "workouts benchmarks") COMPREPLY=($(compgen -W 'list' -- "$cur")) ;;
        "workouts delete") COMPREPLY=($(compgen -W '--force -f' -- "$cur")) ;;
        "health") COMPREPLY=($(compgen -W 'summary steps calories pushes lifetime-totals hr rhr floors sleep stress respiration spo2 hrv body-battery intensity-minutes training-readiness training-status fitness-age max-metrics lactate-threshold cycling-ftp critical-swim-speed power-to-weight thresholds race-predictions endurance-score hill-score power-curve running-economy acclimation one-rep-max events lifestyle' -- "$cur")) ;;
        "health steps") COMPREPLY=($(compgen -W 'view daily weekly monthly' -- "$cur")) ;;
        "health steps daily") COMPREPLY=($(compgen -W '--start --end' -- "$cur")) ;;
        "health steps weekly") COMPREPLY=($(compgen -W '--end --weeks' -- "$cur")) ;;
