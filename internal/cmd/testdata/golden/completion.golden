#!/bin/bash
# bash completion for gccli
# Generated by gccli completion bash

_gccli_completions() {
    # _init_completion is a guard only: bash-completion returns non-zero after
    # it completed a redirection or a $VAR itself. Its words are not used.
    local cur prev words cword
    if type _init_completion &>/dev/null; then
        _init_completion || return
    fi
    # Words come from the line up to the cursor, split at whitespace only, so
    # they are the same with and without bash-completion and on bash 3.2.
    # bash before 4.3 counts COMP_POINT in bytes, and ${s:0:n} counts
    # characters unless the locale is C.
    local line unquoted i w n
    if (( BASH_VERSINFO[0] < 4 || BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 3 )); then
        local LC_ALL=C
    fi
    line=${COMP_LINE:0:COMP_POINT}
    unquoted=${line//[\"\']/}
    IFS=$' \t\n' read -ra words <<< "$unquoted"
    [[ -z $line || $line == *[[:space:]] ]] && words+=("")
    n=$(( ${#words[@]} - 1 ))
    (( n > 0 )) || return

    # bash replaces only its own current word: the text after an open quote,
    # or else the text after the last break character that is not quoted
    # and not escaped. Replies must match that word. bash 3.2 does not split
    # COMP_WORDS at break characters, so take it from the line.
    # The scan jumps from one quote or backslash to the next, because an
    # index lookup per character is slow on a long line. masked is the line
    # with each quoted or escaped character replaced by 0, so the break
    # character cut on it cannot stop inside a quote or after a backslash.
    local c quote="" rest=$line seg masked="" tail re='^([^"'\''\\]*)(["'\''\\]?)'
    while [[ $rest =~ $re ]]; do
        seg=${BASH_REMATCH[1]} c=${BASH_REMATCH[2]}
        rest=${rest:${#BASH_REMATCH[0]}}
        [[ -n $quote ]] && printf -v seg '%.*d' "${#seg}" 0
        masked+=$seg
        if [[ -z $c && -n $rest ]]; then
            # The regex stops at a byte that is not a character in the locale.
            c=${rest:0:1} rest=${rest:1}
        fi
        [[ -n $c ]] || break
        case $quote$c in
            \\|\"\\) seg=${rest:0:1}; rest=${rest:1}; masked+=${seg:+0} ;;
            \"|\') quote=$c cur=$rest ;;
            \"\"|\'\') quote="" ;;
        esac
        masked+=0
    done
    if [[ -z $quote ]]; then
        tail=$masked
        for ((i = 0; i < ${#COMP_WORDBREAKS}; i++)); do
            c=${COMP_WORDBREAKS:i:1}
            tail=${tail##*"$c"}
        done
        cur=${line:${#line}-${#tail}}
    fi

    # A positional at a command with a default subcommand that takes
    # arguments belongs to that subcommand.
    local cmd_path=""
    for ((i = 1; i < n; i++)); do
        w=${words[i]}
        case $w in
            -*=*) ;;
            --account|--active-met|--activities|--activity|--activity-type|--age|--aggregation|--arrive|--badges|--basal-met|--bbox|--bmi|--body-fat|--bone-mass|--brand|--calories|--carbs|--category|--classification|--color|--content|--cursor|--date|--depart|--description|--device|--diastolic|--discharge|--distance|--duration|--end|--end-km|--exercise|--fat|--field|--first-use|--flow|--format|--from|--from-activity|--from-rank|--gender|--goal|--group|--image|--invite|--lat|--level|--limit|--locale|--locale-unit|--location|--lon|--max-chart|--max-distance|--max-grade|--max-poly|--meal|--metabolic-age|--metric|--mfa-code|--min-distance|--min-grade|--model|--month|--months|--moods|--muscle-mass|--name|--note|--notes|--offset|--output|--parent-type-id|--percent-hydration|--period|--physique-rating|--privacy|--profile|--protein|--pulse|--query|--radius|--reps|--return-arrive|--return-depart|--scope|--serving|--servings|--sex-drive|--sexual-activity|--sort|--sport|--start|--start-km|--status|--step|--surface|--symptoms|--systolic|--target|--time|--timezone|--to|--type|--type-id|--type-key|--unit|--units|--until|--url|--visceral-fat-mass|--visceral-fat-rating|--visibility|--weeks|--weight|--wellness|--year|-c|-d|-e|-l|-m|-n|-o|-p|-q|-s|-t) ((i++)) ;;
            -*) ;;
            *)
                case "${cmd_path:+$cmd_path }$w" in
                    "auth"|"auth login"|"auth status"|"auth remove"|"auth token"|"auth export"|"auth import"|"activities"|"activities list"|"activities count"|"activities search"|"activities favorites"|"activities types"|"activities pending"|"activities stats"|"activities stats view"|"activities stats monthly"|"activities privacy"|"activities privacy status"|"activities privacy set"|"activity"|"activity summary"|"activity details"|"activity splits"|"activity typed-splits"|"activity split-summaries"|"activity weather"|"activity hr-zones"|"activity power-zones"|"activity segments"|"activity exercise-sets"|"activity exercise-sets show"|"activity exercise-sets set"|"activity gear"|"activity comments"|"activity comments list"|"activity comments add"|"activity comments edit"|"activity comments delete"|"activity comments likes"|"activity comments likes list"|"activity comments likes add"|"activity comments likes remove"|"activity likes"|"activity likes list"|"activity likes add"|"activity likes remove"|"activity download"|"activity upload"|"activity create"|"activity rename"|"activity retype"|"activity describe"|"activity privacy"|"activity trim"|"activity restore"|"activity favorite"|"activity unfavorite"|"activity delete"|"workouts"|"workouts list"|"workouts detail"|"workouts download"|"workouts upload"|"workouts update"|"workouts create"|"workouts copy"|"workouts send"|"workouts types"|"workouts sport-types"|"workouts schedule"|"workouts schedule add"|"workouts schedule list"|"workouts schedule remove"|"workouts schedule export"|"workouts benchmarks"|"workouts benchmarks list"|"workouts benchmarks set"|"workouts benchmarks clear"|"workouts delete"|"health"|"health summary"|"health steps"|"health steps view"|"health steps daily"|"health steps weekly"|"health steps monthly"|"health calories"|"health calories weekly"|"health pushes"|"health pushes weekly"|"health pushes monthly"|"health lifetime-totals"|"health hr"|"health hr view"|"health hr daily"|"health hr weekly"|"health rhr"|"health floors"|"health floors view"|"health floors daily"|"health floors weekly"|"health sleep"|"health sleep view"|"health sleep naps"|"health sleep naps view"|"health sleep naps add"|"health sleep naps delete"|"health sleep note"|"health sleep daily"|"health sleep weekly"|"health sleep overall"|"health stress"|"health stress view"|"health stress daily"|"health stress weekly"|"health respiration"|"health respiration view"|"health respiration daily"|"health spo2"|"health hrv"|"health snapshots"|"health snapshots list"|"health snapshots show"|"health snapshots epochs"|"health snapshots report"|"health body-battery"|"health body-battery view"|"health body-battery range"|"health body-battery daily"|"health intensity-minutes"|"health intensity-minutes view"|"health intensity-minutes weekly"|"health training-readiness"|"health training-status"|"health training-status view"|"health training-status daily"|"health training-status weekly"|"health fitness-age"|"health max-metrics"|"health lactate-threshold"|"health cycling-ftp"|"health critical-swim-speed"|"health critical-swim-speed view"|"health critical-swim-speed range"|"health critical-swim-speed set"|"health critical-swim-speed delete"|"health power-to-weight"|"health thresholds"|"health thresholds cycling-ftp"|"health thresholds lactate-heart-rate"|"health thresholds lactate-speed"|"health thresholds power-to-weight"|"health race-predictions"|"health race-predictions view"|"health race-predictions range"|"health endurance-score"|"health endurance-score view"|"health endurance-score stats"|"health hill-score"|"health hill-score view"|"health hill-score stats"|"health power-curve"|"health running-tolerance"|"health cycling-ability"|"health progress"|"health progress summary"|"health progress activities"|"health progress metrics"|"health running-economy"|"health acclimation"|"health acclimation range"|"health acclimation daily"|"health one-rep-max"|"health events"|"health lifestyle"|"body"|"body composition"|"bo