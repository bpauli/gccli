0
-- plain requests --
-- plain-header stdout --
#!/bin/bash
# bash completion for gccli
# Generated by gccli completion bash

_gccli_completions() {
    # _init_completion is a guard only: bash-completion returns non-zero after
    # it completed a redirection or a $VAR itself. Its words are not used.
    local cur prev words cword
    if type _init_completion &>/dev/null; then
        _init_completion || return
    fi
    # Words come from the line up to the cursor, split at whitespace only, so
    # they are the same with and without bash-completion and on bash 3.2.
    # bash before 4.3 counts COMP_POINT in bytes, and ${s:0:n} counts
    # characters unless the locale is C.
    local line unquoted i w n
    if (( BASH_VERSINFO[0] < 4 || BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 3 )); then
        local LC_ALL=C
    fi
    line=${COMP_LINE:0:COMP_POINT}
    unquoted=${line//[\"\']/}
    IFS=$' \t\n' read -ra words <<< "$unquoted"
    [[ -z $line || $line == *[[:space:]] ]] && words+=("")
    n=$(( ${#words[@]} - 1 ))
    (( n > 0 )) || return

    # bash replaces only its own current word: the text after an open quote,
    # or else the text after the last break character that is not quoted
    # and not escaped. Replies must match that word. bash 3.2 does not split
    # COMP_WORDS at break characters, so take it from the line.
    # The scan jumps from one quote or backslash to the next, because an
    # index lookup per character is slow on a long line. masked is the line
    # with each quoted or escaped character replaced by 0, so the break
    # character cut on it cannot stop inside a quote or after a backslash.
    local c quote="" rest=$line seg masked="" tail re='^([^"'\''\\]*)(["'\''\\]?)'
    while [[ $rest =~ $re ]]; do
        seg=${BASH_REMATCH[1]} c=${BASH_REMATCH[2]}
        rest=${rest:${#BASH_REMATCH[0]}}
        [[ -n $quote ]] && printf -v seg '%.*d' "${#seg}" 0
        masked+=$seg
        if [[ -z $c && -n $rest ]]; then
            # The regex stops at a byte that is not a character in the locale.
            c=${rest:0:1} rest=${rest:1}
        fi
        [[ -n $c ]] || break
        case $quote$c in
            \\|\"\\) seg=${rest:0:1}; rest=${rest:1}; masked+=${seg:+0} ;;
            \"|\') quote=$c cur=$rest ;;
            \"\"|\'\') quote="" ;;
        esac
        masked+=0
    done
    if [[ -z $quote ]]; then
        tail=$masked
        for ((i = 0; i < ${#COMP_WORDBREAKS}; i++)); do
            c=${COMP_WORDBREAKS:i:1}
            tail=${tail##*"$c"}
        done
        cur=${line:${#line}-${#tail}}
    fi

    # A positional at a command with a default subcommand that takes
    # arguments belongs to that subcommand.
    local cmd_path=""
    for ((i = 1; i < n; i++)); do
        w=${words[i]}
        case $w in
            -*=*) ;;
            --account|--active-met|--basal-met|--bmi|--body-fat|--bone-mass|--category|--color|--date|--diastolic|--distance|--duration|--end|--exercise|--format|--goal|--limit|--locale|--location|--max-chart|--max-poly|--metabolic-age|--mfa-code|--months|--muscle-mass|--name|--note|--notes|--offset|--output|--parent-type-id|--percent-hydration|--physique-rating|--privacy|--pulse|--sort|--start|--status|--step|--systolic|--time|--timezone|--type|--type-id|--type-key|--unit|--units|--url|--visceral-fat-mass|--visceral-fat-rating|--weeks|-c|-d|-e|-l|-n|-o|-p|-s|-t) ((i++)) ;;
            -*) ;;
            *)
                case "${cmd_path:+$cmd_path }$w" in
                    "auth"|"auth login"|"auth status"|"auth remove"|"auth token"|"auth export"|"auth import"|"activities"|"activities list"|"activities count"|"activities search"|"activities types"|"activities pending"|"activities stats"|"activities stats view"|"activities stats monthly"|"activity"|"activity summary"|"activity details"|"activity splits"|"activity typed-splits"|"activity split-summaries"|"activity weather"|"activity hr-zones"|"activity power-zones"|"activity exercise-sets"|"activity exercise-sets show"|"activity exercise-sets set"|"activity gear"|"activity comments"|"activity likes"|"activity download"|"activity upload"|"activity create"|"activity rename"|"activity retype"|"activity delete"|"workouts"|"workouts list"|"workouts detail"|"workouts download"|"workouts upload"|"workouts update"|"workouts create"|"workouts types"|"workouts schedule"|"workouts schedule add"|"workouts schedule list"|"workouts schedule remove"|"workouts schedule export"|"workouts benchmarks"|"workouts benchmarks list"|"workouts delete"|"health"|"health summary"|"health steps"|"health steps view"|"health steps daily"|"health steps weekly"|"health steps monthly"|"health calories"|"health calories weekly"|"health pushes"|"health pushes weekly"|"health pushes monthly"|"health lifetime-totals"|"health hr"|"health hr view"|"health hr daily"|"health hr weekly"|"health rhr"|"health floors"|"health floors view"|"health floors daily"|"health floors weekly"|"health sleep"|"health sleep view"|"health sleep naps"|"health sleep daily"|"health sleep weekly"|"health sleep overall"|"health stress"|"health stress view"|"health stress daily"|"health stress weekly"|"health respiration"|"health respiration view"|"health respiration daily"|"health spo2"|"health hrv"|"health body-battery"|"health body-battery view"|"health body-battery range"|"health intensity-minutes"|"health intensity-minutes view"|"health intensity-minutes weekly"|"health training-readiness"|"health training-status"|"health trai