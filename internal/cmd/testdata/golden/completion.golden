            "courses download --format") COMPREPLY=($(compgen -W 'fit gpx' -- "$cur")) ;;
            "courses import --type"|"courses import -t") COMPREPLY=($(compgen -W 'cycling e_bike_fitness e_bike_mountain gravel_cycling hiking mountain_biking other road_biking running street_running trail_running ultra_run walking' -- "$cur")) ;;
            "courses import --privacy"|"courses import -p") COMPREPLY=($(compgen -W '1 2 4' -- "$cur")) ;;
            "segments search --activity-type") COMPREPLY=($(compgen -W 'cycling running' -- "$cur")) ;;
            "segments search --classification") COMPREPLY=($(compgen -W 'downhill hill_climb hills other sprint' -- "$cur")) ;;
