        "health body-battery") COMPREPLY=($(compgen -W 'view range' -- "$cur")) ;;
        "health body-battery range") COMPREPLY=($(compgen -W '--start --end' -- "$cur")) ;;
        "health intensity-minutes") COMPREPLY=($(compgen -W 'view weekly' -- "$cur")) ;;
        "health intensity-minutes weekly") COMPREPLY=($(compgen -W '--start --end' -- "$cur")) ;;
