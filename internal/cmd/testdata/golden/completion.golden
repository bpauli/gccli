"|"challenges adhoc show"|"challenges adhoc create"|"challenges adhoc invites"|"challenges adhoc invite"|"challenges adhoc accept"|"challenges adhoc decline"|"challenges adhoc leave"|"challenges adhoc delete"|"records"|"records list"|"records types"|"records activity"|"records candidates"|"records candidates list"|"records candidates accept"|"records candidates dismiss"|"records hide"|"records unhide"|"records delete"|"profile"|"profile view"|"profile settings"|"profile privacy"|"profile privacy view"|"profile privacy set"|"profile privacy-zones"|"profile privacy-zones list"|"profile privacy-zones add"|"profile privacy-zones delete"|"profile hr-zones"|"profile power-zones"|"profile power-zones list"|"profile power-zones sport"|"hydration"|"hydration view"|"hydration daily"|"hydration weekly"|"hydration add"|"nutrition"|"nutrition food-log"|"nutrition meals"|"nutrition settings"|"nutrition search"|"nutrition recent"|"nutrition add"|"nutrition quick-add"|"nutrition delete"|"nutrition favorites"|"nutrition favorites list"|"nutrition favorites add"|"nutrition favorites remove"|"training"|"training plans"|"training plan"|"training active"|"training search"|"training schedule"|"training join"|"training leave"|"training task"|"training task move"|"training task delete"|"training coach-workouts"|"events"|"events list"|"events upcoming"|"events add"|"events delete"|"calendar"|"calendar month"|"calendar notes"|"calendar notes add"|"calendar notes update"|"calendar notes move"|"calendar notes delete"|"calendar export"|"calendar export show"|"calendar export enable"|"calendar export disable"|"calendar preferences"|"calendar preferences view"|"calendar preferences set"|"wellness"|"wellness menstrual-cycle"|"wellness menstrual-summary"|"wellness menstrual-calendar"|"wellness menstrual-log"|"wellness menstrual-log view"|"wellness menstrual-log set"|"wellness menstrual-log delete"|"wellness pregnancy-summary"|"wellness jet-lag"|"wellness jet-lag list"|"wellness jet-lag add"|"wellness jet-lag update"|"wellness jet-lag delete"|"wellness jet-lag status"|"exercises"|"exercises list"|"notifications"|"notifications list"|"notifications unread"|"notifications dismiss"|"notifications undismiss"|"notifications preferences"|"notifications preferences view"|"notifications preferences set"|"social"|"social connections"|"social followers"|"social following"|"social requests"|"social feed"|"social follow"|"social unfollow"|"social follow-requests"|"social accept"|"social decline"|"social remove-follower"|"social mute"|"social unmute"|"social muted"|"social search"|"groups"|"groups list"|"groups search"|"groups show"|"groups members"|"groups feed"|"groups activities"|"groups challenges"|"groups join"|"groups leave"|"groups create"|"groups edit"|"groups delete"|"insights"|"insights options"|"insights compare"|"insights preferences"|"golf"|"golf scorecards"|"golf courses"|"golf course"|"golf stats"|"golf shot-stats"|"golf clubs"|"golf club-types"|"golf club-flex-types"|"golf leaderboards"|"reload"|"completion") cmd_path=${cmd_path:+$cmd_path }$w ;;
                    *)
                        case $cmd_path in
                            "activities") cmd_path="activities list" ;;
                            "activities stats") cmd_path="activities stats view" ;;
                            "activities privacy") cmd_path="activities privacy status" ;;
                            "activity") cmd_path="activity summary" ;;
                            "activity exercise-sets") cmd_path="activity exercise-sets show" ;;
                            "activity comments") cmd_path="activity comments list" ;;
                            "activity comments likes") cmd_path="activity comments likes list" ;;
                            "activity likes") cmd_path="activity likes list" ;;
                            "workouts") cmd_path="workouts list" ;;
                            "workouts benchmarks") cmd_path="workouts benchmarks list" ;;
                            "health") cmd_path="health summary" ;;
                            "health steps") cmd_path="health steps view" ;;
                            "health hr") cmd_path="health hr view" ;;
                            "health floors") cmd_path="health floors view" ;;
                            "health sleep") cmd_path="health sleep view" ;;
                            "health sleep naps") cmd_path="health sleep naps view" ;;
                            "health stress") cmd_path="health stress view" ;;
