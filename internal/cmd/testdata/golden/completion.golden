    local word=${words[n]} before_cur flag=""
    before_cur=${word%"$cur"}
    case $before_cur in
        "")
            case ${words[n-1]} in
                --account|--active-met|--activities|--activity|--activity-type|--age|--aggregation|--arrive|--badges|--basal-met|--bbox|--bmi|--body-fat|--bone-mass|--brand|--calories|--carbs|--category|--classification|--color|--content|--cursor|--date|--depart|--description|--device|--diastolic|--discharge|--distance|--duration|--end|--end-km|--exercise|--fat|--field|--first-use|--flow|--format|--from|--from-activity|--from-rank|--gender|--goal|--group|--image|--invite|--lat|--level|--limit|--locale|--locale-unit|--location|--lon|--max-chart|--max-distance|--max-grade|--max-poly|--meal|--metabolic-age|--metric|--mfa-code|--min-distance|--min-grade|--model|--month|--months|--moods|--muscle-mass|--name|--note|--notes|--offset|--output|--parent-type-id|--percent-hydration|--period|--physique-rating|--privacy|--profile|--protein|--pulse|--query|--radius|--reps|--return-arrive|--return-depart|--scope|--serving|--servings|--sex-drive|--sexual-activity|--sort|--sport|--start|--start-km|--status|--step|--surface|--symptoms|--systolic|--target|--time|--timezone|--to|--type|--type-id|--type-key|--unit|--units|--until|--url|--visceral-fat-mass|--visceral-fat-rating|--visibility|--weeks|--weight|--wellness|--year|-c|-d|-e|-l|-m|-n|-o|-p|-q|-s|-t) flag=${words[n-1]} ;;
            esac ;;
        -*=) flag=${before_cur%=} ;;
        *) return ;;
    esac

    if [[ -n $flag ]]; then
        case "$cmd_path $flag" in
            "activity download --format") COMPREPLY=($(compgen -W 'fit gpx tcx kml csv' -- "$cur")) ;;
            "workouts create --type") COMPREPLY=($(compgen -W 'run bike swim strength cardio hiit yoga pilates mobility multisport custom' -- "$cur")) ;;
            "workouts create --unit") COMPREPLY=($(compgen -W 'km mi' -- "$cur")) ;;
            "workouts benchmarks set --unit") COMPREPLY=($(compgen -W 'kg lbs' -- "$cur")) ;;
            "health critical-swim-speed set --unit") COMPREPLY=($(compgen -W 'm yd' -- "$cur")) ;;
            "health endurance-score stats --aggregation") COMPREPLY=($(compgen -W 'weekly monthly' -- "$cur")) ;;
            "health hill-score stats --aggregation") COMPREPLY=($(compgen -W 'daily weekly monthly' -- "$cur")) ;;
            "health running-tolerance --aggregation") COMPREPLY=($(compgen -W 'daily weekly monthly' -- "$cur")) ;;
            "health cycling-ability --aggregation") COMPREPLY=($(compgen -W 'daily weekly monthly' -- "$cur")) ;;
            "health progress summary --aggregation") COMPREPLY=($(compgen -W 'daily weekly monthly yearly all' -- "$cur")) ;;
            "body add-weight --unit") COMPREPLY=($(compgen -W 'kg lbs' -- "$cur")) ;;
            "body export-blood-pressure --period") COMPREPLY=($(compgen -W 'daily seven-days four-weeks yearly' -- "$cur")) ;;
            "gear add --type") COMPREPLY=($(compgen -W 'shoes bike other' -- "$cur")) ;;
            "goals list --status") COMPREPLY=($(compgen -W 'active future past' -- "$cur")) ;;
            "goals add --period") COMPREPLY=($(compgen -W 'seven-days thirty-days one-month annual' -- "$cur")) ;;
