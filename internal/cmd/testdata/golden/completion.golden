        "health hr weekly") COMPREPLY=($(compgen -W '--end --weeks' -- "$cur")) ;;
        "health floors") COMPREPLY=($(compgen -W 'view daily weekly' -- "$cur")) ;;
        "health floors daily") COMPREPLY=($(compgen -W '--start --end' -- "$cur")) ;;
