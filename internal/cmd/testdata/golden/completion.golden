        "body composition") COMPREPLY=($(compgen -W '--start --end' -- "$cur")) ;;
        "body weigh-ins") COMPREPLY=($(compgen -W '--start --end' -- "$cur")) ;;
        "body add-weight") COMPREPLY=($(compgen -W '--unit' -- "$cur")) ;;
        "body add-composition") COMPREPLY=($(compgen -W '--body-fat --percent-hydration --visceral-fat-mass --bone-mass --muscle-mass --basal-met --active-met --physique-rating --metabolic-age --visceral-fat-rating --bmi' -- "$cur")) ;;
        "body delete-weight") COMPREPLY=($(compgen -W '--date --force -f' -- "$cur")) ;;
        "body blood-pressure") COMPREPLY=($(compgen -W '--start --end' -- "$cur")) ;;
        "body add-blood-pressure") COMPREPLY=($(compgen -W '--systolic --diastolic --pulse --notes' -- "$cur")) ;;
        "body delete-blood-pressure") COMPREPLY=($(compgen -W '--date --force -f' -- "$cur")) ;;
        "devices") COMPREPLY=($(compgen -W 'list settings primary solar alarms last-used sensors backups historical messages' -- "$cur")) ;;
        "devices solar") COMPREPLY=($(compgen -W '--start --end' -- "$cur")) ;;
        "gear") COMPREPLY=($(compgen -W 'list stats activities defaults link unlink types collections' -- "$cur")) ;;
        "gear activities") COMPREPLY=($(compgen -W '--limit' -- "$cur")) ;;
        "gear collections") COMPREPLY=($(compgen -W 'list' -- "$cur")) ;;
        "goals") COMPREPLY=($(compgen -W 'list weight' -- "$cur")) ;;
        "goals list") COMPREPLY=($(compgen -W '--status' -- "$cur")) ;;
        "goals weight") COMPREPLY=($(compgen -W '--start --end' -- "$cur")) ;;
        "badges") COMPREPLY=($(compgen -W 'earned available in-progress detail compare leaderboard' -- "$cur")) ;;
        "courses") COMPREPLY=($(compgen -W 'list favorites detail download import send delete' -- "$cur")) ;;
        "courses download") COMPREPLY=($(compgen -W '--format --output -o' -- "$cur")) ;;
        "courses import") COMPREPLY=($(compgen -W '--name -n --type -t --privacy -p' -- "$cur")) ;;
        "courses delete") COMPREPLY=($(compgen -W '--force -f' -- "$cur")) ;;
        "challenges") COMPREPLY=($(compgen -W 'list badge available completed virtual' -- "$cur")) ;;
        "challenges virtual") COMPREPLY=($(compgen -W 'available completed in-progress' -- "$cur")) ;;
        "records") COMPREPLY=($(compgen -W 'list types activity' -- "$cur")) ;;
        "profile") COMPREPLY=($(compgen -W 'view settings privacy privacy-zones hr-zones power-zones' -- "$cur")) ;;
        "profile privacy") COMPREPLY=($(compgen -W 'view' -- "$cur")) ;;
        "profile privacy-zones") COMPREPLY=($(compgen -W 'list' -- "$cur")) ;;
        "hydration") COMPREPLY=($(compgen -W 'view daily weekly add' -- "$cur")) ;;
