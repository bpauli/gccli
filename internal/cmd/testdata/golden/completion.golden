        "activity") COMPREPLY=($(compgen -W 'summary details splits typed-splits split-summaries weather hr-zones power-zones segments exercise-sets gear comments likes download upload create rename retype describe privacy trim restore favorite unfavorite delete' -- "$cur")) ;;
        "activity details") COMPREPLY=($(compgen -W '--max-chart --max-poly' -- "$cur")) ;;
