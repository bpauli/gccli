        "events") COMPREPLY=($(compgen -W 'list upcoming add delete' -- "$cur")) ;;
        "events list") COMPREPLY=($(compgen -W '--start --limit -l --offset --sort' -- "$cur")) ;;
        "events add") COMPREPLY=($(compgen -W '--name -n --date -d --type -t --race --location --time --timezone --distance --goal --primary --training --private --note --url' -- "$cur")) ;;
        "events delete") COMPREPLY=($(compgen -W '--force -f' -- "$cur")) ;;
        "wellness") COMPREPLY=($(compgen -W 'menstrual-cycle menstrual-summary menstrual-calendar pregnancy-summary jet-lag' -- "$cur")) ;;
