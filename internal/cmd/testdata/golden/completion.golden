            "insights compare --field") COMPREPLY=($(compgen -W 'AVG_SPEED VO2_MAX_VALUE AVG_POWER WEEKLY_AVG_DISTANCE WEEKLY_AVG_DURATION STEPS SLEEP FLOORS COUNT' -- "$cur")) ;;
            "insights compare --gender") COMPREPLY=($(compgen -W 'ALL M F' -- "$cur")) ;;
