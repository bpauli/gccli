                            "goals weight") cmd_path="goals weight view" ;;
                            "badges") cmd_path="badges earned" ;;
                            "courses") cmd_path="courses list" ;;
                            "segments") cmd_path="segments list" ;;
                            "challenges") cmd_path="challenges list" ;;
                            "challenges adhoc") cmd_path="challenges adhoc list" ;;
                            "records") cmd_path="records list" ;;
                            "records candidates") cmd_path="records candidates list" ;;
                            "profile") cmd_path="profile view" ;;
                            "profile privacy") cmd_path="profile privacy view" ;;
                            "profile privacy-zones") cmd_path="profile privacy-zones list" ;;
                            "profile power-zones") cmd_path="profile power-zones list" ;;
