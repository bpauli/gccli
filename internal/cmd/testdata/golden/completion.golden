        "health") COMPREPLY=($(compgen -W 'summary steps calories pushes lifetime-totals hr rhr floors sleep stress respiration spo2 hrv snapshots body-battery intensity-minutes training-readiness training-status fitness-age max-metrics lactate-threshold cycling-ftp critical-swim-speed power-to-weight thresholds race-predictions endurance-score hill-score power-curve running-tolerance cycling-ability progress running-economy acclimation one-rep-max events lifestyle' -- "$cur")) ;;
