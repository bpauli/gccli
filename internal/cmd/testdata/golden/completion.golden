    fi

    case $cmd_path in
        "") COMPREPLY=($(compgen -W 'auth activities activity workouts health body devices gear goals badges courses segments challenges records profile hydration nutrition training events calendar wellness exercises notifications social groups insights golf reload completion --json -j --plain --header --color --account --units --version' -- "$cur")) ;;
