--device picks one of several devices.
-- args --
workouts
send
111
--device
3003
-- route GET /workout-service/workout/111 --
{"workoutId":111,"workoutName":"Tempo Run","sportType":{"sportTypeId":1,"sportTypeKey":"running"}}
-- route GET /device-service/deviceregistration/devices --
[{"deviceId":3001,"displayName":"Forerunner 265","workoutCapable":true,"runningWorkoutCapable":true,"cyclingWorkoutCapable":false,"swimWorkoutCapable":true,"swimWorkout2Capable":false,"workoutFileType":"FIT"},{"deviceId":3003,"displayName":"fenix 8","workoutCapable":true,"runningWorkoutCapable":true,"cyclingWorkoutCapable":true,"swimWorkoutCapable":true,"swimWorkout2Capable":true,"multisportWorkoutCapable":true,"workoutFileType":"FIT"},{"deviceId":3004,"displayName":"vivoactive HR","workoutCapable":false,"workoutFileType":null}]
-- route POST /device-service/devicemessage/messages --
[{"deviceId":3003,"deviceName":"fenix 8","messageId":889,"messageStatus":"new","metaDataId":111}]
