Error case: in --start/--end range mode the second week answers 400, so the loop stops with exit code 1 (error).
-- args --
workouts
schedule
list
--start
2026-10-01
--end
2026-10-15
-- route GET /calendar-service/year/2026/month/9/day/1/start/0 --
{"calendarItems":[{"id":21,"itemType":"workout","title":"Tempo","sportTypeKey":"running","date":"2026-10-02","workoutId":901}]}
-- route GET /calendar-service/year/2026/month/9/day/8/start/0 400 noeol --
{"message":"Bad Request"}
