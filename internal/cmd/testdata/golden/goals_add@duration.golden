A one-month duration goal without --start starts on the first day of this month, because Garmin answers any other day with 400. The duration goes in seconds, and the activity type defaults to all.
-- args --
goals
add
Ride 10 hours
--period
one-month
--duration
10h
-- route POST /goal-service/goal/goal --
{"id":12345678,"name":"Run 50 km","type":"distance_accumulation","distanceInMeters":50000.0,"startDate":"2026-10-12","endDate":"2026-10-18","activityType":"running","period":"seven_days","privacy":"public","active":true,"completed":false}
