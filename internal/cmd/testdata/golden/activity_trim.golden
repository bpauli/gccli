--from and --to are times since the activity start. Garmin takes the range in epoch milliseconds, from summaryDTO.startTimeGMT (UTC).
-- args --
activity
trim
12345678
--from
2m
--to
50m
-- route GET /activity-service/activity/12345678 --
{"activityId":12345678,"activityName":"Morning Run","isMultiSportParent":false,"summaryDTO":{"startTimeGMT":"2026-01-10T08:00:00.0","startTimeLocal":"2026-01-10T09:00:00.0","elapsedDuration":3461.0,"duration":3400.5}}
-- route PUT /activity-service/activity/12345678/reconstruct 202 --
{"detailedImportResult":{"uploadId":987654,"uploadUuid":{"uuid":"0b5c4c2e-1111-2222-3333-444455556666"},"owner":3141592,"processingTime":42,"creationDate":"2026-01-11 10:00:00.0 GMT","successes":[],"failures":[]}}
