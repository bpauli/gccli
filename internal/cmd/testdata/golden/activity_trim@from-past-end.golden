Error case: --from alone is after the activity end, so the exit code is 1 (error) and no PUT is sent.
-- args --
activity
trim
12345678
--from
1h
-- route GET /activity-service/activity/12345678 --
{"activityId":12345678,"activityName":"Morning Run","isMultiSportParent":false,"summaryDTO":{"startTimeGMT":"2026-01-10T08:00:00.0","startTimeLocal":"2026-01-10T09:00:00.0","elapsedDuration":3461.0,"duration":3400.5}}
-- table stdout --
-- table stderr --
--from 1h0m0s is not before the end of activity 12345678 at 57m41s
-- table exit --
1
-- table requests --
GET /activity-service/activity/12345678
