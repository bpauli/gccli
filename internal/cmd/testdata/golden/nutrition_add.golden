Garmin has no read of one food by ID, so the command finds the food in the search results for --query and takes its source, region, language and first serving from there. The meal time is the start time of the meal, and the message names the new entry, found in the answer by the time of the write.
-- args --
nutrition
add
2026-10-15
1001
--query
apple
--meal
breakfast
-- route GET /nutrition-service/food/search?searchExpression=apple&start=0&limit=50 noeol --
{"moreDataAvailable":false,"results":[{"type":"FOOD","foodMetaData":{"foodId":"1002","foodName":"Test Pie","foodType":"GENERIC","source":"FATSECRET","regionCode":"US","languageCode":"en"},"foodImages":[],"nutritionContents":[{"servingId":"2101","servingUnit":"slice","numberOfUnits":1.0,"calories":300}],"isRecent":false,"isFavorite":false},{"type":"FOOD","foodMetaData":{"foodId":"1001","foodName":"Test Apple","foodType":"GENERIC","source":"FATSECRET","regionCode":"US","languageCode":"en"},"foodImages":[],"nutritionContents":[{"servingId":"2001","servingUnit":"medium","numberOfUnits":1.0,"calories":95},{"servingId":"2002","servingUnit":"cup, sliced","numberOfUnits":1.0,"calories":56.5}],"isRecent":false,"isFavorite":false}]}
-- route GET /nutrition-service/meals/2026-10-15 noeol --
{"dailyViewType":"TIMELINE_VIEW","meals":[{"mealId":101,"mealName":"BREAKFAST","startTime":"07:00:00","endTime":"08:59:00","enabled":true},{"mealId":102,"mealName":"LUNCH","startTime":"12:00:00","endTime":"13:59:00","enabled":true},{"mealId":103,"mealName":"DINNER","startTime":"18:00:00","endTime":"20:59:00","enabled":true},{"mealId":104,"mealName":"CUSTOM_MEAL_1","startTime":null,"endTime":null,"enabled":false},{"mealId":105,"mealName":"SNACKS","startTime":null,"endTime":null,"enabled":true}]}
-- route PUT /nutrition-service/food/logs noeol --
{"mealDate":"2026-10-15","mealDetails":[{"meal":{"mealId":101,"mealName":"BREAKFAST"},"loggedFoods":[{"logId":"aaaa1111","logTimestamp":"2026-10-15T06:10:00.000Z","logCategory":"REGULAR_LOG","mealId":101,"mealTime":"07:00:00"}]},{"meal":{"mealId":101,"mealName":"BREAKFAST"},"loggedFoods":[{"logId":"bbbb2222","logTimestamp":"2026-10-15T09:30:00.000Z","logCategory":"REGULAR_LOG","mealId":101,"mealTime":"07:00:00"}]}]}
-- table stdout --
-- table stderr --
Added Test Apple (1 x medium) to breakfast on 2026-10-15 (log ID: bbbb2222)
-- table exit --
0
-- table requests --
GET /nutrition-service/food/search?searchExpression=apple&start=0&limit=50
GET /nutrition-service/meals/2026-10-15
PUT /nutrition-service/food/logs
  {
    "foodLogItems": [
      {
        "logId": null,
        "logTimestamp": "2026-10-15T09:30:00.000Z",
        "logSource": "GCW",
        "logCategory": "REGULAR_LOG",
        "mealTime": "07:00:00",
        "action": "ADD",
        "mealId": 101,
        "foodId": "1001",
        "servingId": "2001",
        "source": "FATSECRET",
        "regionCode": "US",
        "languageCode": "en",
        "servingQty": 1,
        "customMealId": null
      }
    ],
    "mealDate": "2026-10-15"
  }
