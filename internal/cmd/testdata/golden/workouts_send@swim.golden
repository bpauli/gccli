A swim workout to a device without swimWorkout2Capable names the device in the message URL, as the web app does.
-- args --
workouts
send
111
-- route GET /workout-service/workout/111 --
{"workoutId":111,"workoutName":"Pool 400","sportType":{"sportTypeId":4,"sportTypeKey":"swimming"}}
-- route GET /device-service/deviceregistration/devices --
[{"deviceId":3001,"displayName":"Forerunner 265","workoutCapable":true,"runningWorkoutCapable":true,"cyclingWorkoutCapable":false,"swimWorkoutCapable":true,"swimWorkout2Capable":false,"workoutFileType":"FIT"},{"deviceId":3002,"displayName":"Edge 1040","workoutCapable":true,"runningWorkoutCapable":false,"cyclingWorkoutCapable":true,"workoutFileType":"FIT"}]
-- route POST /device-service/devicemessage/messages --
[{"deviceId":3001,"deviceName":"Forerunner 265","messageId":888,"messageStatus":"new","metaDataId":111}]
-- table stdout --
-- table stderr --
Sent workout "Pool 400" to Forerunner 265 (message 888). It reaches the device at its next sync. To cancel it before then, run: gccli devices messages cancel 888
-- table exit --
0
-- table requests --
GET /workout-service/workout/111
GET /device-service/deviceregistration/devices
POST /device-service/devicemessage/messages
  [
    {
      "deviceId": 3001,
      "fileType": "FIT",
      "groupName": null,
      "messageName": "Pool 400",
      "messageType": "workouts",
      "messageUrl": "workout-service/workout/FIT/111?deviceId=3001",
      "metaDataId": 111,
      "priority": 1
    }
  ]
