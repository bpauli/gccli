A workout of more than 50 steps, not counting rest steps and counting each repeat, needs a device with enhancedWorkoutStepCapable, as in the web app. 25 repeats of two steps plus a warmup and a cooldown are 52 steps, so only one device is left.
-- args --
workouts
send
112
-- route GET /workout-service/workout/112 noeol --
{"workoutId":112,"workoutName":"Long Intervals","sportType":{"sportTypeId":1,"sportTypeKey":"running"},"workoutSegments":[{"segmentOrder":1,"sportType":{"sportTypeId":1,"sportTypeKey":"running"},"workoutSteps":[{"type":"ExecutableStepDTO","stepType":{"stepTypeKey":"warmup"}},{"type":"RepeatGroupDTO","numberOfIterations":25,"stepType":{"stepTypeKey":"repeat"},"workoutSteps":[{"type":"ExecutableStepDTO","stepType":{"stepTypeKey":"interval"}},{"type":"ExecutableStepDTO","stepType":{"stepTypeKey":"recovery"}}]},{"type":"ExecutableStepDTO","stepType":{"stepTypeKey":"cooldown"}}]}]}
-- route GET /device-service/deviceregistration/devices noeol --
[{"deviceId":3001,"displayName":"Forerunner 265","workoutCapable":true,"runningWorkoutCapable":true,"enhancedWorkoutStepCapable":true,"workoutFileType":"FIT"},{"deviceId":3005,"displayName":"Forerunner 55","workoutCapable":true,"runningWorkoutCapable":true,"enhancedWorkoutStepCapable":false,"workoutFileType":"FIT"}]
-- route POST /device-service/devicemessage/messages noeol --
[{"deviceId":3001,"deviceName":"Forerunner 265","messageId":890,"messageStatus":"new","metaDataId":112}]
