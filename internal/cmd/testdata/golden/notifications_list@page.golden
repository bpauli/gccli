--limit and --cursor go into the query, so the request asks for the next page.
-- args --
notifications
list
--limit
3
--cursor
abc
-- route GET /notification-service/notification/notification/cursor?limit=3&cursor=abc --
{"notificationList":[{"notificationId":12345,"type":"CONNECTION_REQUEST"}],"pagination":{"cursor":"abc","limit":3,"nextCursor":"abd","start":3}}
